    // ファイル選択
    //   読み込みが終わるまでボタンを押させない。
    //   以前は読み込みを待たずに有効化していたので、大きいファイルだと
    //   押しても何も起きないことがあった。
    // ========================================================
    function readFileAsArrayBuffer(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload  = () => resolve(reader.result);
            reader.onerror = () => reject(new Error('ファイルを読み込めませんでした'));
            reader.readAsArrayBuffer(file);
        });
    }

    pdfInput.addEventListener('change', async (e) => {
        if (!e.target.files.length) return;
        selectedFile = e.target.files[0];
        pdfBytes   = null;
        lastGroups = null;
        processBtn.disabled = true;
        resplitBtn.disabled = true;

        const mb = selectedFile.size / 1048576;
        log('ファイルを選択しました: ' + selectedFile.name + '（' + mb.toFixed(1) + ' MB）', 'head');
        log('読み込み中です。しばらくお待ちください...');

        try {
            pdfBytes = await readFileAsArrayBuffer(selectedFile);
            log('読み込み完了。開始できます。', 'good');
            if (mb > BIG_FILE_MB) {
                log('⚠ 大きいファイルです。ページ数が多いと時間がかかります。'
                  + '途中でAPIが混み合った場合は自動で待って再試行します。', 'warn');
            }
            processBtn.disabled = false;
        } catch (err) {
            log('❌ ' + err.message, 'bad');
        }
    });

    // ========================================================
    // 文字列の整形
    // ========================================================

    // 患者IDを6桁にそろえる
    //   院内の手術伝票は 0000513572 のように0埋めされた10桁、
    //   手術伝票プラスは 513572 のように0埋めなしで印字されるため、
    //   どちらから読んでも同じ 513572 になるように下6桁で統一する。
    function patientId6(s) {
        const d = String(s || "").replace(/[^0-9]/g, "");
        if (!d) return "";
        if (d.length > 6) return d.slice(-6);          // 先頭の0埋めを落として下6桁
        return ("000000" + d).slice(-6);               // 6桁に満たなければ0で埋める
    }

    // 「2026/07/16」「2026.7.6」などを 20260716 の8桁にそろえる
    function ymd8(s) {
        const t = String(s || "").trim();
        if (!t) return "";
        const parts = t.split(/[^0-9]+/).filter(x => x.length);
        if (parts.length >= 3 && parts[0].length === 4) {
            return parts[0] + ("0" + parts[1]).slice(-2) + ("0" + parts[2]).slice(-2);
        }
        const digits = t.replace(/[^0-9]/g, "");
        return digits.length >= 8 ? digits.slice(0, 8) : digits;
    }

    // ファイル名に使えない文字を落とし、前後と間の空白を整える
    function cleanForName(s) {
        return String(s || "")
            .replace(/[\\\\/:*?"<>|]/g, "_")   // 使えない記号
            .replace(/[\\s\\u3000]+/g, "")       // 半角・全角の空白は詰める
            .trim();
    }

    // ========================================================
    // AIへの問い合わせ（再試行つき）
    //   429（混雑）や5xx（一時障害）、通信エラー、タイムアウトは
    //   待ってから何度か試す。ここが無かったために、途中で1回失敗すると
    //   それまでの解析がすべて無駄になっていた。
    // ========================================================
    function backoffMs(attempt) {
        const base = Math.min(RETRY_CAP_MS, RETRY_BASE_MS * Math.pow(2, attempt - 1));
        return base + Math.floor(Math.random() * 500);   // 少しばらして同時再開を避ける
    }

    async function recognizePage(base64Image, pageNum) {
        let lastErr = null;

        for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
            const ac = new AbortController();
            const timer = setTimeout(() => ac.abort(), REQ_TIMEOUT_MS);
            let res = null, json = null, netErr = null;

            try {
                res = await fetch('/api/recognize', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ image: base64Image }),
                    signal: ac.signal
                });
                try { json = await res.json(); } catch (e) { json = null; }
            } catch (e) {
                netErr = e;
            }
            clearTimeout(timer);

            // 成功
            if (!netErr && res && res.ok && json && json.ok) return json.data;

            // 失敗の種類を見分ける
            let retryable, label;
            if (netErr) {
                const aborted = netErr.name === 'AbortError';
                retryable = true;
                label = aborted ? '応答なし（' + Math.round(REQ_TIMEOUT_MS / 1000) + '秒待っても返らず）' : '通信エラー';
                lastErr = new Error(label);
            } else {
                const st = res ? res.status : 0;
                const msg = (json && json.error) ? String(json.error) : ('HTTP ' + st);
                retryable = (json && typeof json.retryable === 'boolean')
                    ? json.retryable
                    : (st === 429 || st === 408 || st >= 500);
                label = (st === 429 ? 'API混雑（429）' : 'エラー（' + st + '）') + ' ' + msg.slice(0, 160);
                lastErr = new Error(msg.slice(0, 300));
            }

            if (!retryable || attempt === MAX_ATTEMPTS) {
                if (!retryable) log('   ページ ' + pageNum + ': ' + label + ' ／ 再試行しても直らない種類のエラーです', 'bad');
                break;
            }

            // Retry-Afterの指示があればそれに従う
            let wait = backoffMs(attempt);
            const ra = res ? Number(res.headers.get('Retry-After')) : 0;
            if (ra > 0) wait = Math.min(RETRY_CAP_MS, ra * 1000) + 300;

            log('   ⏳ ページ ' + pageNum + ': ' + label
              + ' ／ ' + Math.round(wait / 1000) + '秒待って再試行します（'
              + attempt + '/' + (MAX_ATTEMPTS - 1) + '回目）', 'warn');
            await sleep(wait);
        }

        throw lastErr || new Error('不明なエラー');
    }

    // ========================================================
    // 1ページを画像にする
    //   使い終わったキャンバスはすぐ解放する。
    //   ページ数が多いと解放しないぶんがメモリに残り続けるため。
    // ========================================================
    async function pageToDataUrl(pdfDocument, pageNum) {
        const page = await pdfDocument.getPage(pageNum);
        try {
            const viewport = page.getViewport({ scale: RENDER_SCALE });
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');

            // 上部だけを切り取る（「手術伝票」のタイトル部分を含めるため）
            //   viewport には既に scale が掛かっているので、ここで transform を
            //   重ねると倍率が二重（1.5×1.5=2.25倍）になり、用紙の左上しか写らない。
            //   右端にある「手術日」が画角から外れて読めなくなるため transform は渡さない。
            //   キャンバスを低くしておくことで、はみ出した下部は描かれない。
            canvas.width  = Math.floor(viewport.width);
            canvas.height = Math.floor(viewport.height * CROP_RATIO);

            await page.render({ canvasContext: ctx, viewport: viewport }).promise;
            const url = canvas.toDataURL('image/jpeg', JPEG_QUALITY);

            canvas.width = 0; canvas.height = 0;        // 解放
            return url;
        } finally {
            try { page.cleanup(); } catch (e) {}
        }
    }

    // ========================================================
    // 解析（AIに1ページずつ聞いてグループに分ける）
    // ========================================================
    async function analyze(pdfDocument, totalPages) {
        const groups = [];
        const failed = [];
        let currentGroup = null;
        const t0 = Date.now();

        for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
            const imageData = await pageToDataUrl(pdfDocument, pageNum);

            let aiResult;
            try {
                aiResult = await recognizePage(imageData, pageNum);
            } catch (e) {
                // ここまで粘って駄目だったページ。
                // 処理は止めず「直前のセットの続き」として扱う。
                //   勝手に新しい区切りを作るより、まとまってしまうほうが
                //   後からページ数のズレで気づけるため。
                failed.push({ page: pageNum, reason: e.message });
                log('❌ ページ ' + pageNum + ' は読み取れませんでした（' + e.message.slice(0, 120) + '）', 'bad');
                log('   直前のセットの続きとして扱います。最後にまとめて報告します。', 'bad');
                aiResult = { isFirstPage: false, patientId: '', patientName: '', title: '', date: '' };
            }

            if (aiResult.isFirstPage) {
                if (currentGroup && currentGroup.pages.length > 0) groups.push(currentGroup);
                currentGroup = {
                    id:    aiResult.patientId   || "不明ID",
                    name:  aiResult.patientName || "",
                    title: aiResult.title       || "記録用紙",
                    date:  aiResult.date        || "日付不明",
                    pages: [pageNum - 1]        // pdf-libのページインデックスは0始まり
                };
                log('✨ ページ ' + pageNum + ': 新しい手術伝票'
                  + '（番号 ' + (patientId6(aiResult.patientId) || '不明')
                  + ' / ' + (aiResult.date || '日付不明') + '）', 'good');
            } else {
                if (currentGroup) {
                    currentGroup.pages.push(pageNum - 1);
                } else {
                    // 先頭から「手術伝票」でないページが出た場合のフェイルセーフ
                    currentGroup = { id: "不明ID", name: "", title: "記録用紙", date: "日付不明", pages: [pageNum - 1] };
                    log('⚠ 先頭ページが「手術伝票」ではありません。不明グループとして開始します。', 'warn');
                }
            }

            const elapsed = (Date.now() - t0) / 1000;
            const eta = elapsed / pageNum * (totalPages - pageNum);
            setBar(pageNum, totalPages,
                '解析 ' + pageNum + ' / ' + totalPages + ' ページ　残り約 ' + fmtSec(eta));

            if (pageNum < totalPages && PAGE_GAP_MS > 0) await sleep(PAGE_GAP_MS);
        }

        if (currentGroup && currentGroup.pages.length > 0) groups.push(currentGroup);
        return { groups, failed };
    }

    // ========================================================
    // 分割して保存
    // ========================================================
    async function splitAndDownload(groups, prefix) {
        // 念のための確認。pdf.jsに渡したバッファが解放されていると0になる
        if (!pdfBytes || pdfBytes.byteLength === 0) {
            throw new Error('元PDFのデータが失われています。ファイルを選び直してください。');
        }
        // 分割用にここで初めてpdf-libに読ませる（解析中は抱えない）
        const pdfDocLib = await PDFLib.PDFDocument.load(pdfBytes);
        let ok = 0;

        for (let i = 0; i < groups.length; i++) {
            const group = groups[i];
            setBar(i, groups.length, 'ファイル作成 ' + (i + 1) + ' / ' + groups.length);

            const newPdf = await PDFLib.PDFDocument.create();
            const copiedPages = await newPdf.copyPages(pdfDocLib, group.pages);
            copiedPages.forEach((page) => newPdf.addPage(page));
            const newPdfBytes = await newPdf.save();

            // ファイル名の組み立て（接頭語_手術日_患者ID_患者名.pdf）
            //   患者名はチェックが入っている時だけ。読み取れなかった項目は飛ばす。
            const safeName = useNameInput.checked ? cleanForName(group.name) : "";
            const parts = [];
            if (prefix)     parts.push(cleanForName(prefix));
            if (group.date) parts.push(ymd8(group.date));
            if (group.id)   parts.push(patientId6(group.id) || cleanForName(group.id));
            if (safeName)   parts.push(safeName);
            const fileName = (parts.filter(Boolean).join("_") || "記録用紙") + ".pdf";

            // ダウンロード。Blob URLは使い終わったら解放する
            //   解放しないと出力したPDFがすべてメモリに残り続ける。
            const blob = new Blob([newPdfBytes], { type: 'application/pdf' });
            const url  = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            link.click();
            setTimeout(() => URL.revokeObjectURL(url), 60000);

            log('✅ 出力完了: ' + fileName + '（' + group.pages.length + 'ページ）', 'good');
            ok++;

            // 連続ダウンロードがブラウザにブロックされないよう待機
            if (i < groups.length - 1) await sleep(DL_GAP_MS);
        }
        setBar(groups.length, groups.length, 'ファイル作成 完了');
        return ok;
    }

    // ========================================================
    // 最後の報告
    // ========================================================
    function report(groups, failed, totalPages) {
        hr();
        log('■ 結果', 'head');
        log('　ページ数 ' + totalPages + ' ／ 出力ファイル ' + groups.length + ' 件');

        const sum = groups.reduce((a, g) => a + g.pages.length, 0);
        if (sum !== totalPages) {
            log('⚠ ページ数の合計（' + sum + '）が元PDF（' + totalPages + '）と一致しません。確認してください。', 'warn');
        }

        if (failed.length) {
            log('⚠ 読み取れなかったページが ' + failed.length + ' 件あります。', 'warn');
            failed.forEach(f => log('　・ページ ' + f.page + '：' + String(f.reason).slice(0, 120), 'warn'));
            log('　これらのページは直前のセットに入っています。', 'warn');
            log('　該当するファイルのページ数を確認し、必要なら手で分けてください。', 'warn');
            log('　そのうえでもう一度やり直す場合は「解析と分割を開始」を押し直してください。', 'warn');
        } else {
            log('🎉 すべてのページを読み取れました。', 'good');
        }

        log('ファイル名の一覧を確認し、同じ患者番号が並んでいないか見ておいてください。');
    }

    // ========================================================
    // 本処理
    // ========================================================
    processBtn.addEventListener('click', async () => {
        if (busy) return;
        if (!pdfBytes) { log('⚠ まだファイルの読み込みが終わっていません。', 'warn'); return; }

        busy = true;
        processBtn.disabled = true;
        resplitBtn.disabled = true;
        showBar(true);
        const prefix = prefixInput.value.trim();

        hr();
        log('--- 処理を開始します ---', 'head');
        if (prefix) log('接頭語 [' + prefix + '] を適用します');

        const tAll = Date.now();
        let pdfDocument = null;

        try {
            // pdf.jsには「ビュー」を渡す（コピーは作らない）。
            //   このバージョンのpdf.jsは渡したArrayBufferを奪わないので、
            //   あとで pdf-lib に同じものを渡せる。コピーを作ると元PDFと
            //   同じ容量をもう一つ抱えることになり、大きいファイルで不利。
            const loadingTask = pdfjsLib.getDocument({ data: new Uint8Array(pdfBytes) });
            pdfDocument = await loadingTask.promise;
            const totalPages = pdfDocument.numPages;
            log('PDF総ページ数: ' + totalPages + 'ページ', 'head');

            const { groups, failed } = await analyze(pdfDocument, totalPages);

            hr();
            log('解析完了。' + groups.length + '件に分かれました。', 'head');
            groups.forEach((g, i) => {
                log('　' + (i + 1) + '. 番号 ' + (patientId6(g.id) || g.id)
                  + ' ／ ' + (g.date || '日付不明')
                  + ' ／ ' + g.pages.length + 'ページ');
            });

            // 解析結果を残す。分割だけ失敗したときにAIへ問い直さず作り直せる
            lastGroups = groups;
            resplitBtn.disabled = false;

            // 解析が終わればpdf.js側はもう使わない。
            //   元PDFと同じ容量をpdf.jsのワーカーが抱えているので、
            //   分割（pdf-lib）を始める前に解放してピークを下げる。
            try { await pdfDocument.destroy(); } catch (e) {}
            pdfDocument = null;

            hr();
            log('ファイルの分割・作成を開始します。');
            await splitAndDownload(groups, prefix);

            report(groups, failed, totalPages);
            log('所要時間 ' + fmtSec((Date.now() - tAll) / 1000), 'head');

        } catch (error) {
            const msg = (error && error.message) ? error.message : String(error);
            log('❌ 処理を中断しました: ' + msg, 'bad');
            if (lastGroups) {
                log('解析結果は保持しています。「再分割のみ」で作り直せます（追加費用なし）。', 'warn');
            }
            console.error(error);
        } finally {
            if (pdfDocument) { try { await pdfDocument.destroy(); } catch (e) {} }
            processBtn.disabled = false;
            // 解析結果が残っていれば再分割できる状態に戻す
            resplitBtn.disabled = !lastGroups;
            busy = false;
        }
    });

    // 解析をやり直さずに分割だけ作り直す
    resplitBtn.addEventListener('click', async () => {
        if (busy) return;
        if (!lastGroups || !pdfBytes) { log('⚠ 保持している解析結果がありません。', 'warn'); return; }

        busy = true;
        processBtn.disabled = true;
        resplitBtn.disabled = true;
        showBar(true);

        hr();
        log('--- 再分割します（AIへの問い合わせはしません） ---', 'head');
        try {
            const n = await splitAndDownload(lastGroups, prefixInput.value.trim());
            log('🎉 ' + n + '件を作り直しました。', 'good');
        } catch (error) {
            log('❌ 再分割に失敗しました: ' + ((error && error.message) || String(error)), 'bad');
            console.error(error);
        } finally {
            processBtn.disabled = false;
            resplitBtn.disabled = false;
            busy = false;
        }
    });
</script>
</body>
</html>`;
