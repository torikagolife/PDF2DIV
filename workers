// ============================================================
// PDFセパレーター自動分割ツール（Cloudflare Worker）
// ------------------------------------------------------------
//  スキャンした手術伝票の束PDFを、患者ごとのPDFに切り分ける。
//  「手術伝票」と書かれたページを区切りとして検出する部分だけAIに任せ、
//  分割・ファイル名付け・保存はすべてブラウザ内で行う。
//
//  [v3 の修正点]
//   ・API呼び出しに再試行（指数バックオフ）を入れた
//       → 途中で1回429や通信エラーが出ても全損しなくなった。
//         これまではページ数が多い（＝元ファイルが大きい）ほど
//         「どこかで1回失敗して出力0件」になる確率が上がっていた。
//   ・最後まで読めなかったページがあっても処理を止めず、
//     どのページが読めなかったかを最後にまとめて報告する
//   ・FileReaderの完了を待ってからボタンを有効化（大きいファイルの空振り防止）
//   ・ログをinnerHTMLの連結からappendChildに変更（数百行でも重くならない）
//     併せてAIの返り値をHTMLとして解釈しないようにした
//   ・Blob URLとキャンバスを都度解放（出力PDFがメモリに残り続けるのを防ぐ）
//   ・AIへの問い合わせにタイムアウトを設定
//   ・Worker側が429を500に書き換えず、本来のステータスで返すようにした
//   ・解析結果を保持し、「再分割のみ」でAIに問い直さず作り直せるようにした
// ============================================================

// ---------- AI問い合わせの設定（ここだけ見れば変えられる） ----------
const OPENAI_MODEL      = "gpt-4o";

// ★画像の精度。"low"（1ページ約0.2円）か "high"（約0.4円）。
//   以前「highにした」と伺っていたので high にしてあります。
//   low に戻す場合はここ1行だけ書き換えてください。
const IMAGE_DETAIL      = "high";

const OPENAI_TIMEOUT_MS = 55000;     // OpenAIからの応答を待つ上限

export default {
  async fetch(request, env) {
    // CORS設定（ブラウザからの通信を許可）
    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    // ---------- IP制限（院内からの接続のみ許可） ----------
    // 環境変数 ALLOW_IPS に許可するグローバルIPを設定する。
    // 未設定なら制限しない（設定漏れで自分が入れなくなるのを防ぐため）。
    if (!ipAllowed(request, env)) {
      return denyResponse();
    }

    const url = new URL(request.url);

    // 画面（フロントエンド）を返すルート
    if (request.method === "GET" && (url.pathname === "/" || url.pathname === "")) {
      return new Response(FRONT_HTML, {
        headers: { "content-type": "text/html; charset=utf-8" },
      });
    }

    // AI解析用APIルート（PDFの1ページごとの画像を解析）
    if (request.method === "POST" && url.pathname === "/api/recognize") {
      return await recognize(request, env, corsHeaders);
    }

    return new Response("Not Found", { status: 404, headers: corsHeaders });
  }
};

// ============================================================
// 1ページ分の画像をAIに判定させる
//   ステータスは書き換えずにそのまま返す。
//   429（レート制限）や5xx（一時的な障害）をブラウザ側が見分けて
//   待ってから再試行できるようにするため。
// ============================================================
async function recognize(request, env, corsHeaders) {
  const jsonHeaders = { "Content-Type": "application/json", ...corsHeaders };
  const fail = (status, error, retryable, extra) =>
    new Response(JSON.stringify({ ok: false, error, status, retryable: !!retryable }), {
      status,
      headers: Object.assign({}, jsonHeaders, extra || {})
    });

  try {
    if (!env.OPENAI_API_KEY) {
      return fail(500, "APIキーが未設定です", false);
    }

    let body;
    try {
      body = await request.json();
    } catch (e) {
      return fail(400, "リクエストを読めませんでした", false);
    }

    const imageBase64 = body && body.image;
    if (!imageBase64 || typeof imageBase64 !== "string") {
      return fail(400, "画像データがありません", false);
    }
    if (imageBase64.indexOf("data:image/") !== 0) {
      return fail(400, "画像の形式が想定と違います", false);
    }

    // OpenAIが応答しないまま止まらないよう上限を設ける
    const ac = new AbortController();
    const timer = setTimeout(() => ac.abort(), OPENAI_TIMEOUT_MS);

    let openAiRes;
    try {
      openAiRes = await fetch("https://api.openai.com/v1/chat/completions", {
        method: "POST",
        signal: ac.signal,
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${env.OPENAI_API_KEY}`
        },
        body: JSON.stringify({
          model: OPENAI_MODEL,
          messages: [
            {
              role: "system",
              content: "あなたは医療機関の帳票を読み取る凄腕のアシスタントです。提供された画像（用紙の一部）から情報を抽出してください。\n最も重要なのは、そのページが「手術伝票」かどうかを判定することです。"
            },
            {
              role: "user",
              content: [
                { type: "image_url", image_url: { url: imageBase64, detail: IMAGE_DETAIL } },
                { type: "text", text: "この画像内に「手術伝票」という文字があるかを判定し、ある場合のみ手術日・患者番号・患者氏名・術式名を抽出してください。" }
              ]
            }
          ],
          temperature: 0,
          response_format: {
            type: "json_schema",
            json_schema: {
              name: "separator_info",
              strict: true,
              schema: {
                type: "object",
                properties: {
                  isFirstPage: { type: "boolean", description: "画像内に「手術伝票」という記載があればtrue、それ以外の帳票であればfalseにしてください" },
                  patientId: { type: "string", description: "「患者番号」または「患者ID」の欄の数字（例: 513572, 0000222414）。0埋めされていてもそのまま全桁読み取る。見つからない場合は空文字" },
                  patientName: { type: "string", description: "「氏名（カナ）」欄に書かれている患者のカナ氏名。全角カタカナで書かれている（例: テストカンジャ、ヤマダ タロウ）。姓と名の間の空白は残す。濁点や半濁点は文字と一体で読む（ダ・パなど。タ゛のように分けない）。塗りつぶされている・空欄・読み取れない場合は空文字。推測で氏名を作らないこと" },
                  title: { type: "string", description: "「施行術式」または「術後術式」の欄の術式名。見つからない場合は空文字" },
                  date: { type: "string", description: "「手術日」の欄の日付。用紙の右上、患者名の右隣にあることが多い。2026/07/16 のような形式なので 20260716 のように数字8桁で返す。「印刷日時」や「生年月日」と間違えないこと。見つからない場合は空文字" }
                },
                required: ["isFirstPage", "patientId", "patientName", "title", "date"],
                additionalProperties: false
              }
            }
          }
        })
      });
    } catch (e) {
      clearTimeout(timer);
      // 中断（タイムアウト）や通信障害。どちらも時間を置けば直る可能性がある
      const aborted = e && e.name === "AbortError";
      return fail(504, aborted ? "OpenAIの応答がありませんでした（タイムアウト）" : "OpenAIに接続できませんでした", true);
    }
    clearTimeout(timer);

    if (!openAiRes.ok) {
      const errText = (await openAiRes.text().catch(() => "")).slice(0, 400);
      const st = openAiRes.status;
      // 429（レート制限）と5xx（一時障害）は待てば直る。それ以外は直らない
      const retryable = st === 429 || st === 408 || st >= 500;
      const extra = {};
      const ra = openAiRes.headers.get("Retry-After");
      if (ra) extra["Retry-After"] = ra;      // OpenAIの指示をそのまま渡す
      return fail(st, "OpenAI APIエラー(" + st + "): " + errText, retryable, extra);
    }

    const data = await openAiRes.json();
    const resultText = data && data.choices && data.choices[0] &&
                       data.choices[0].message && data.choices[0].message.content;
    if (!resultText) {
      return fail(502, "AIの応答が空でした", true);
    }

    let resultJson;
    try {
      resultJson = JSON.parse(resultText);
    } catch (e) {
      return fail(502, "AIの応答を解釈できませんでした", true);
    }

    return new Response(JSON.stringify({ ok: true, data: resultJson }), { headers: jsonHeaders });

  } catch (e) {
    return fail(500, (e && e.message) ? e.message : String(e), true);
  }
}

// ============================================================
// IP制限
//   ALLOW_IPS に許可IPを書く。カンマ・空白・改行のどれで区切ってもよい。
//   単独のIP（192.0.2.10）と、範囲指定のCIDR（192.0.2.0/24）に対応。
//   IPv4・IPv6どちらも書ける。
//   未設定のときは制限しない（ロックアウト防止）。
// ============================================================
function clientIp(request) {
  return (request.headers.get("CF-Connecting-IP") || "").trim();
}

function ipAllowed(request, env) {
  const raw = String((env && env.ALLOW_IPS) || "").trim();
  if (!raw) return true;                       // 未設定なら素通り

  const ip = clientIp(request);
  if (!ip) return false;                       // 取得できない場合は通さない

  const list = raw.split(/[\s,]+/).filter(Boolean);
  for (const entry of list) {
    if (matchIp(ip, entry)) return true;
  }
  return false;
}

function matchIp(ip, entry) {
  const slash = entry.indexOf("/");
  if (slash < 0) {
    // 単独IP。表記ゆれ（IPv6の大文字小文字や省略形）を吸収して比べる
    return normIp(ip) === normIp(entry);
  }
  const net = entry.slice(0, slash);
  const bits = parseInt(entry.slice(slash + 1), 10);
  if (isNaN(bits)) return false;

  const a = ipToBytes(ip);
  const b = ipToBytes(net);
  if (!a || !b || a.length !== b.length) return false;   // v4とv6は比べない
  if (bits < 0 || bits > a.length * 8) return false;

  let full = bits >> 3;                                   // 丸ごと一致するバイト数
  for (let i = 0; i < full; i++) if (a[i] !== b[i]) return false;
  const rest = bits & 7;
  if (rest) {
    const mask = 0xff << (8 - rest) & 0xff;
    if ((a[full] & mask) !== (b[full] & mask)) return false;
  }
  return true;
}

function normIp(s) {
  const b = ipToBytes(String(s || "").trim());
  if (!b) return String(s || "").trim().toLowerCase();
  return b.join(".");
}

// IPv4は4バイト、IPv6は16バイトの配列にする。読めなければ null
function ipToBytes(str) {
  const s = String(str || "").trim();
  if (!s) return null;

  if (s.indexOf(":") < 0) {
    const p = s.split(".");
    if (p.length !== 4) return null;
    const out = [];
    for (const x of p) {
      if (!/^\d{1,3}$/.test(x)) return null;
      const n = parseInt(x, 10);
      if (n > 255) return null;
      out.push(n);
    }
    return out;
  }

  // IPv6（末尾がIPv4表記のものも受ける）
  let t = s.toLowerCase();
  let tail = [];
  const lastColon = t.lastIndexOf(":");
  const afterLast = t.slice(lastColon + 1);
  if (afterLast.indexOf(".") >= 0) {
    const v4 = ipToBytes(afterLast);
    if (!v4) return null;
    tail = v4;
    t = t.slice(0, lastColon + 1) + "0:0";
  }

  const dbl = t.indexOf("::");
  let head = [], rear = [];
  const toWords = (part) => {
    if (!part) return [];
    const out = [];
    for (const h of part.split(":")) {
      if (!/^[0-9a-f]{1,4}$/.test(h)) return null;
      const n = parseInt(h, 16);
      out.push((n >> 8) & 0xff, n & 0xff);
    }
    return out;
  };
  if (dbl >= 0) {
    head = toWords(t.slice(0, dbl));
    rear = toWords(t.slice(dbl + 2));
    if (head === null || rear === null) return null;
  } else {
    head = toWords(t);
    if (head === null) return null;
  }

  const used = head.length + rear.length + tail.length;
  if (used > 16) return null;
  const zeros = new Array(16 - used).fill(0);
  const bytes = head.concat(zeros, rear, tail);
  return bytes.length === 16 ? bytes : null;
}

// 院外からの接続。詳細は出さない（接続元IPや案内文は表示しない）
function denyResponse() {
  return new Response(DENY_HTML, {
    status: 403,
    headers: {
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-store",
    },
  });
}

