// ============================================================
// フロント画面HTML
// ============================================================
const FRONT_HTML = `<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>PDFセパレーター自動分割ツール</title>
    <!-- 絵文字ファビコンの設定 -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text x=%2250%%22 y=%2250%%22 style=%22dominant-baseline:central;text-anchor:middle;font-size:90px;%22>💔</text></svg>">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic UI", Meiryo, sans-serif; margin: 20px; background-color: #f4f7f6; color: #333; }
        .container { max-width: 800px; margin: 0 auto; background: #fff; padding: 25px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        h1 { font-size: 22px; color: #2b2f36; border-bottom: 2px solid #0056b3; padding-bottom: 10px; margin-top: 0; }
        .controls { margin: 20px 0; padding: 18px; background: #fbfcfd; border: 1px solid #e4e7ec; border-radius: 8px; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-weight: bold; margin-bottom: 6px; font-size: 14px; }
        input[type="text"], input[type="file"] { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; font-size: 14px; }
        input[type="text"]:focus { outline: 2px solid rgba(0, 86, 179, 0.3); border-color: #0056b3; }
        button { background-color: #0056b3; color: white; border: none; padding: 12px 20px; font-size: 15px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: 0.2s; width: 100%; }
        button:hover { opacity: 0.9; }
        button:disabled { background-color: #ccc; cursor: not-allowed; }
        .checkline { display: flex; align-items: center; gap: 8px; font-weight: bold; font-size: 14px; cursor: pointer; }
        .checkline input { width: 17px; height: 17px; }
        .note { font-size: 12px; color: #6c8286; margin-top: 5px; line-height: 1.7; }
        #log { width: 100%; height: 350px; overflow-y: auto; background: #2b2f36; color: #4af626; padding: 12px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 13px; box-sizing: border-box; line-height: 1.5; border-radius: 6px; margin-top: 20px; }
    </style>
    <!-- pdf.js と pdf-lib のCDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
</head>
<body>

<div class="container">
    <h1>📄 PDFセパレーター自動分割ツール</h1>
    
    <div class="controls">
        <div class="form-group">
            <label for="prefixInput">🏷️ ファイル名の接頭語（自由入力）</label>
            <input type="text" id="prefixInput" placeholder="例: 202604人工関節">
        </div>

        <div class="form-group">
            <label for="pdfInput">📁 対象のPDF（複数ページの束）を選択</label>
            <input type="file" id="pdfInput" accept="application/pdf">
        </div>

        <div class="form-group">
            <label class="checkline">
              <input type="checkbox" id="useNameInput" checked>
              ファイル名に患者名を入れる
            </label>
            <div class="note">接頭語_手術日_患者番号_<b>患者名</b>.pdf の形式になります。外すと患者名なしで出力します。</div>
        </div>
        
        <button id="processBtn" disabled>🚀 解析と分割を開始</button>
    </div>

    <div id="log">待機中... PDFを選択してください。</div>
</div>

<script>
    // PDF.jsのワーカー設定
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';

    const pdfInput = document.getElementById('pdfInput');
    const prefixInput = document.getElementById('prefixInput');
    const useNameInput = document.getElementById('useNameInput');
    const processBtn = document.getElementById('processBtn');
    const logDiv = document.getElementById('log');

    let selectedFile = null;
    let pdfBytes = null;

    function log(message) {
        const time = new Date().toLocaleTimeString();
        logDiv.innerHTML += \`[\${time}] \${message}<br>\`;
        logDiv.scrollTop = logDiv.scrollHeight;
    }

    pdfInput.addEventListener('change', async (e) => {
        if (e.target.files.length > 0) {
            selectedFile = e.target.files[0];
            processBtn.disabled = false;
            log(\`ファイルを選択しました: \${selectedFile.name}\`);
            
            const reader = new FileReader();
            reader.onload = function(evt) {
                pdfBytes = evt.target.result;
            };
            reader.readAsArrayBuffer(selectedFile);
        }
    });

    // 患者IDを7桁にそろえる
    //   院内の手術伝票は 0000513572 のように0埋めされた10桁、
    //   手術伝票プラスは 513572 のように0埋めなしで印字されるため、
    //   どちらから読んでも同じ 0513572 になるように下7桁で統一する。
    function patientId7(s) {
        const d = String(s || "").replace(/[^0-9]/g, "");
        if (!d) return "";
        if (d.length > 7) return d.slice(-7);          // 先頭の0埋めを落として下7桁
        return ("0000000" + d).slice(-7);              // 7桁に満たなければ0で埋める
    }

    // 「2026/07/16」「2026.7.6」などを 20260716 の8桁にそろえる
    function ymd8(s) {
        const t = String(s || "").trim();
        if (!t) return "";
        const parts = t.split(/[^0-9]+/).filter(x => x.length);
        if (parts.length >= 3 && parts[0].length === 4) {
            return parts[0] + ("0" + parts[1]).slice(-2) + ("0" + parts[2]).slice(-2);
        }
        const digits = t.replace(/[^0-9]/g, "");
        return digits.length >= 8 ? digits.slice(0, 8) : digits;
    }

    // ファイル名に使えない文字を落とし、前後と間の空白を整える
    function cleanForName(s) {
        return String(s || "")
            .replace(/[\\\\/:*?"<>|]/g, "_")   // 使えない記号
            .replace(/[\\s\\u3000]+/g, "")       // 半角・全角の空白は詰める
            .trim();
    }

    // Workers上のAPIを呼び出す関数
    async function recognizeImageByAPI(base64Image) {
        const res = await fetch('/api/recognize', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: base64Image })
        });
        const json = await res.json();
        if (!json.ok) throw new Error(json.error);
        return json.data;
    }

    processBtn.addEventListener('click', async () => {
        if (!pdfBytes) return;
        processBtn.disabled = true;
        const prefix = prefixInput.value.trim();
        log('--- 処理を開始します ---');
        if (prefix) log(\`接頭語 [\${prefix}] を適用します\`);

        try {
            // PDFの読み込み
            const loadingTask = pdfjsLib.getDocument({ data: pdfBytes });
            const pdfDocument = await loadingTask.promise;
            const totalPages = pdfDocument.numPages;
            log(\`PDF総ページ数: \${totalPages}ページ\`);

            const pdfDocLib = await PDFLib.PDFDocument.load(pdfBytes);

            let groups = []; 
            let currentGroup = null;

            // 1ページずつ解析してグループ分け
            for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
                log(\`----------------------------------------\`);
                log(\`ページ \${pageNum} を解析中...\`);
                const page = await pdfDocument.getPage(pageNum);
                
                const scale = 1.5;
                const viewport = page.getViewport({ scale: scale });

                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                
                // 上部40%だけを切り取る (「手術伝票」のタイトル部分を含めるため)
                //   viewport には既に scale が掛かっているので、ここで transform を
                //   重ねると倍率が二重（1.5×1.5=2.25倍）になり、用紙の左上しか写らない。
                //   右端にある「手術日」が画角から外れて読めなくなるため transform は渡さない。
                const cropWidth = viewport.width;
                const cropHeight = viewport.height * 0.4;
                canvas.width = cropWidth;
                canvas.height = cropHeight;

                await page.render({
                    canvasContext: ctx,
                    viewport: viewport
                }).promise;

                const imageData = canvas.toDataURL('image/jpeg', 0.8);

                // AIへ送信
                log('☁️ AI(API)へ画像を送信中...');
                const aiResult = await recognizeImageByAPI(imageData);

                log(\`🔍 認識結果: 手術伝票=\${aiResult.isFirstPage ? 'はい' : 'いいえ'}, 手術日=\${aiResult.date || 'なし'}, ID=\${aiResult.patientId || 'なし'}, 氏名=\${aiResult.patientName || 'なし'}\`);

                // 「手術伝票」という文字が見つかった場合 ＝ 新しいセットの始まり
                if (aiResult.isFirstPage) {
                    log(\`✨ 新しい手術伝票を検知: ページ \${pageNum}\`);

                    // すでに作成中のグループがあれば、リストに保存
                    if (currentGroup && currentGroup.pages.length > 0) {
                        groups.push(currentGroup);
                    }

                    // 新しいグループを作成
                    currentGroup = {
                        id: aiResult.patientId || "不明ID",
                        name: aiResult.patientName || "",
                        title: aiResult.title || "記録用紙",
                        date: aiResult.date || "日付不明",
                        pages: [pageNum - 1] // pdf-libのページインデックスは0始まり
                    };
                } else {
                    // 「手術伝票」ではない場合 ＝ 今のセットの続き（次のIDの前まで）
                    if (currentGroup) {
                        currentGroup.pages.push(pageNum - 1);
                        log(\`📄 今のセットにページを追加しました。\`);
                    } else {
                        // 最初から「手術伝票」がないページが出た場合のフェイルセーフ
                        currentGroup = {
                            id: "不明ID",
                            name: "",
                            title: "記録用紙",
                            date: "日付不明",
                            pages: [pageNum - 1]
                        };
                        log(\`⚠ 先頭ページが「手術伝票」ではありません。不明グループとして開始します。\`);
                    }
                }
            }

            // 最後のグループを保存
            if (currentGroup && currentGroup.pages.length > 0) {
                groups.push(currentGroup);
            }

            log('----------------------------------------');
            log('解析完了。ファイルの分割・作成を開始します。');

            // グループごとにPDFを生成・ダウンロード
            for (let i = 0; i < groups.length; i++) {
                const group = groups[i];
                log(\`ファイル作成中... (\${patientId7(group.id) || group.id} : 計\${group.pages.length}ページ)\`);

                const newPdf = await PDFLib.PDFDocument.create();
                const copiedPages = await newPdf.copyPages(pdfDocLib, group.pages);
                copiedPages.forEach((page) => newPdf.addPage(page));

                const newPdfBytes = await newPdf.save();

                // ファイル名の組み立て（接頭語_手術日_患者ID_患者名.pdf）
                //   患者名はチェックが入っている時だけ。読み取れなかった項目は飛ばす。
                const safeName = useNameInput.checked ? cleanForName(group.name) : "";

                const parts = [];
                if (prefix)     parts.push(cleanForName(prefix));
                if (group.date) parts.push(ymd8(group.date));
                if (group.id)   parts.push(patientId7(group.id) || cleanForName(group.id));
                if (safeName)   parts.push(safeName);

                let fileName = (parts.filter(Boolean).join("_") || "記録用紙") + ".pdf";

                // ダウンロード処理
                const blob = new Blob([newPdfBytes], { type: 'application/pdf' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = fileName;
                link.click();

                log(\`✅ 出力完了: \${fileName}\`);
                
                // 連続ダウンロードがブラウザにブロックされないよう待機
                await new Promise(resolve => setTimeout(resolve, 600));
            }

            log('🎉 すべての処理が完了しました！');

        } catch (error) {
            log(\`❌ エラーが発生しました: \${error.message}\`);
            console.error(error);
        } finally {
            processBtn.disabled = false;
        }
    });
</script>
</body>
</html>`;
