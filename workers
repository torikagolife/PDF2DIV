    const RETRY_CAP_MS   = 30000;   // 待ち時間の上限
    const REQ_TIMEOUT_MS = 60000;   // 1回の問い合わせを待つ上限
    const PAGE_GAP_MS    = 120;     // 連続送信の間隔（レート制限を避ける）
    const DL_GAP_MS      = 600;     // 連続ダウンロードの間隔
    const BIG_FILE_MB    = 150;     // これを超えたら注意を表示
